{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://theweil.github.io/PS5-ZSTD-Compatibility/schema/test.schema.json",
  "title": "PS5 ZSTD Compatibility Database — test reports document",
  "description": "Validates data/tests.json. Each element is ONE independent test report. Unknown values must be null or an explicit unknown enum, never invented.",
  "type": "object",
  "required": ["meta", "tests"],
  "additionalProperties": false,
  "properties": {
    "meta": { "type": "object" },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/test" }
    }
  },
  "definitions": {
    "regionCode": {
      "type": "string",
      "enum": ["HK", "US", "EU", "JP", "AS", "MULTI", "UNKNOWN"]
    },
    "ppsa": {
      "type": ["string", "null"],
      "pattern": "^PPSA[0-9]{5}$"
    },
    "historyEntry": {
      "type": "object",
      "required": ["kind", "description"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["prior_state", "environment_change", "external_report", "third_party_claim", "source_classification", "record_update"]
        },
        "description": { "type": "string", "minLength": 1 },
        "result": { "type": ["string", "null"], "enum": ["pass", "fail", "partial", "unknown", null] }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["label", "url"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "url": { "type": "string", "pattern": "^https?://" }
      }
    },
    "test": {
      "type": "object",
      "required": [
        "id", "game_id", "game_title_raw", "ppsa", "ppsa_raw", "ppsa_all",
        "ppsa_status", "region", "regions", "compression", "result",
        "verification", "tester", "tester_raw", "tested_at",
        "ps5_firmware", "game_version", "converter", "runtime_version",
        "mount_tool", "evidence", "source_record_ids", "source_table",
        "source_row", "symptom", "notes", "history"
      ],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "pattern": "^test-[0-9]{4}[a-z]?$" },
        "game_id": { "type": "string", "minLength": 1 },
        "game_title_raw": { "type": "string", "minLength": 1 },
        "ppsa": { "$ref": "#/definitions/ppsa" },
        "ppsa_raw": { "type": "string" },
        "ppsa_all": {
          "type": "array",
          "items": { "type": "string", "pattern": "^PPSA[0-9]{5}$" }
        },
        "ppsa_status": { "type": "string", "enum": ["present", "missing"] },
        "region": { "$ref": "#/definitions/regionCode" },
        "regions": { "type": "array", "items": { "$ref": "#/definitions/regionCode" } },
        "region_raw": { "type": ["string", "null"] },
        "compression": { "type": "string", "enum": ["zstd", "lz4", "unknown"] },
        "compression_raw": { "type": ["string", "null"] },
        "compression_scope": {
          "type": "string",
          "enum": ["explicit", "zstd_issue_scope", "unknown"]
        },
        "compression_note": { "type": "string" },
        "result": { "type": "string", "enum": ["pass", "fail", "partial", "unknown"] },
        "result_note": { "type": "string" },
        "verification": {
          "type": "string",
          "enum": ["community_report", "maintainer_reproduced", "single_source", "unknown"]
        },
        "tester": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "tester_raw": { "type": "string", "minLength": 1 },
        "tested_at": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "ps5_firmware": { "type": ["string", "null"] },
        "game_version": { "type": ["string", "null"] },
        "converter": { "type": ["string", "null"] },
        "runtime_version": { "type": ["string", "null"] },
        "mount_tool": { "type": ["string", "null"] },
        "evidence": { "type": "array", "items": { "$ref": "#/definitions/evidence" } },
        "source_record_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^(?:[PF]-[0-9]{3}|I-[0-9]{3})$" }
        },
        "source_type": { "type": "string", "enum": ["archive", "issue"] },
        "issue_number": { "type": "integer", "minimum": 1 },
        "issue_url": { "type": "string", "pattern": "^https://github[.]com/" },
        "submitted_by": { "type": "string" },
        "submitted_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "source_table": { "type": "string", "enum": ["pass", "problem", "issue"] },
        "source_row": { "type": "integer", "minimum": 1 },
        "symptom": { "type": ["string", "null"] },
        "notes": { "type": "string" },
        "history": { "type": "array", "items": { "$ref": "#/definitions/historyEntry" } },
        "game_identification": {
          "type": "string",
          "enum": ["confirmed", "uncertain", "unidentified"]
        },
        "derivation": { "type": "string" }
      }
    }
  }
}
